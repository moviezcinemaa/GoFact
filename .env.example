# ── Database (Neon PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/digitak?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg://user:password@ep-example-123456.us-east-2.aws.neon.tech/digitak?sslmode=require

# ── LLM Providers (free tiers, rotated automatically) ──────────────
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── App Config ─────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=1440
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Docker local PostgreSQL (used only in docker-compose) ──────────
POSTGRES_USER=gofact
POSTGRES_PASSWORD=gofact_local
POSTGRES_DB=gofact
